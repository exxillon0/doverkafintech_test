# Base configuration for Payment Stack

# API configuration
API_PORT=8080
LOG_LEVEL=DEBUG

# Database configuration (initial defaults, will be overridden by Vault)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=payments
POSTGRES_DB=payments
POSTGRES_PASSWORD=db_password_123

# RabbitMQ configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=rabbit_password_123

# Vault configuration
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-root-token-stage
VAULT_DEV_ROOT_TOKEN=dev-root-token-stage

# Provider configuration
PROVIDER_API_KEY=provider_api_key_123

# Application version
APP_VERSION=1.0.0